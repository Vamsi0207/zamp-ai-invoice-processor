# Export these variables in your shell; the application does not load .env automatically.
ZAMP_DB_PATH=data/zamp.sqlite3
ZAMP_DOCUMENT_DIR=data/documents
# Optional full executable path; blank/unset discovers tesseract on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Optional: extraction calls fail with HTTP 503 when the selected key is absent.
GEMINI_API_KEY=
# Owner-verified local demo selection. If unset, the application's fallback is
# gemini-3.5-flash-lite; this example is not loaded automatically.
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional local demo gate; required by the private Docker mode. Set both or neither.
# Generate a unique random password (at least 24 characters); never commit it.
ZAMP_REQUIRE_DEMO_AUTH=0
ZAMP_DEMO_USERNAME=
ZAMP_DEMO_PASSWORD=
# Public synthetic-only mode is opt-in and conflicts with any private auth settings.
# Use a NEW database/document path, never an existing private workspace.
ZAMP_PUBLIC_DEMO=0
# Optional public-mode global limits; the defaults below apply if unset.
ZAMP_DEMO_AI_PER_MINUTE=2
ZAMP_DEMO_AI_PER_DAY=20
ZAMP_DEMO_AI_TOTAL=100
ZAMP_DEMO_UPLOADS_PER_MINUTE=6
ZAMP_DEMO_WRITES_PER_MINUTE=20
ZAMP_DEMO_WRITES_TOTAL=500
ZAMP_DEMO_READS_PER_MINUTE=600
ZAMP_DEMO_MAX_RETRIES=3
ZAMP_DEMO_MAX_BODY_BYTES=1048576
